<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#9eb8ff" android:endColor="#ffffff" android:angle="90.0" android:type="linear" />
            <padding android:left="0.0dp" android:top="0.0dp" android:right="0.0dp" android:bottom="0.0dp" />
            <size android:height="60.0dp" android:width="60.0dp" />
            <stroke android:width="1.0dp" android:color="#ff3da6ef" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#ffd9d9d9" android:endColor="#ffffff" android:angle="90.0" android:type="linear" />
            <padding android:left="0.0dp" android:top="0.0dp" android:right="0.0dp" android:bottom="0.0dp" />
            <size android:height="60.0dp" android:width="60.0dp" />
            <stroke android:width="0.5dp" android:color="#ffcecece" />
        </shape>
    </item>
</selector>
