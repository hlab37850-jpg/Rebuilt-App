    const-string v3, "UPDATE items_cost_calc\nSET n_q = \n              ifnull((SELECT Previous.n_q\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t\tand Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  +(case when ((substr(tr_type,1,1)*1=2 and is_back=0) or (tr_type=1 and is_back=1) \n\t\t\t  or (tr_type=3 and i_q<>0) or tr_type=0  or (tr_type=4 and adj_id in(2,4) ))  then i_q\n\t\t\t  else -1*o_q end)\n\t\t,n_t = \n\t\tcase \n\t\twhen ((substr(tr_type,1,1)*1=2 and is_back=0) or tr_type=0 or (tr_type=4 and adj_id in(2,4)))  then -- Purchase or Opening balance or Adj_IN\n              ifnull((SELECT Previous.n_t\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  + (i_q*i_u )\n\t\t\n\t\twhen (tr_type=4 and adj_id not in(2,4))  then --  Adj_OUT\n              ifnull((SELECT Previous.n_t\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  - (o_q*o_u )\n\t\twhen tr_type=1 and is_back=1  then -- Sales Return \n              ifnull((SELECT Previous.n_t\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t\t and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  + (i_q*\n\t\t\t    ifnull(ifnull((SELECT Previous.n_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.bill_id=items_cost_calc.bill_no*1\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,\n\t\t\t  --Sales return in general\n\t\t\t  (SELECT Previous.n_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   --and Previous.bill_id=items_cost_calc.bill_no*1\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              )\n\t\t\t  ),0)\n\t\t\t  )\n\t\t\t  \t\t\n\t\t\t  \n\t\twhen ((tr_type=3 and i_q<>0) ) then --  Order \tIN \n\tifnull((SELECT Previous.n_t\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  + (\n\t\t\t  i_q*ifnull((SELECT Previous.n_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   -- ver 03-Mar-19\n\t\t\t   and Previous.br_id=items_cost_calc.to_br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  )\n\t\t\n\t\twhen (tr_type=2 and is_back=1)  then -- Purchase Return \n\t(ifnull((SELECT Previous.n_t\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  - (o_q*ifnull(ifnull((SELECT Previous.i_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   \tand Previous.bill_id=items_cost_calc.bill_no*1\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,\n\t\t\t  --Purchase return in general\n\t\t\t  (SELECT Previous.n_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   --\tand Previous.bill_id=items_cost_calc.bill_no*1\n\t\t\t   and Previous.is_back=0\n\t\t\t   order by Previous.rowid desc limit 1\n              )),0)\n\t\t\t  )\t)\n\t\t\n\t\twhen (substr(tr_type,1,1)*1=1 and is_back=0) or(tr_type=3 or o_q<>0)  then\t--Sales or Outcome Order\t \n              ifnull((SELECT Previous.n_u\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   --ver 03-Mar-19\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  *(\n\t\t\t  ifnull((SELECT Previous.n_q\n\t\t\t  FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item_id\n\t\t\t   and Previous.br_id=items_cost_calc.br_id\n\t\t\t   order by Previous.rowid desc limit 1\n              ) ,0)\n\t\t\t  - o_q \t\t\n\t\t\t  )\n\t\t\n\t  end\t\n\t,n_u = \n\tifnull(\n\t\tcase \n\t\twhen (substr(tr_type,1,1)*1=2 and is_back=0) or tr_type=0 or (tr_type=4 and adj_id in(2,4))  then\t\t --Purchase or Adj IN\n\t\t-- N total\n\t\tifnull(\n              (ifnull((SELECT Previous.n_t\n               FROM items_cost_calc AS Previous\n               WHERE Previous.rowid < items_cost_calc.rowid\n\t\t\t   and Previous.item_id=items_cost_calc.item